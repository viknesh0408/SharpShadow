# SharpShadow Environment Variables

# Frontend
VITE_API_URL=http://localhost:8080

# Backend Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/sharpshadow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# JWT Security (Generate a unique 64-character hex string)
JWT_SECRET=your_secure_random_64_char_hex_jwt_secret_here

# Razorpay Integration (Test Mode by default)
RAZORPAY_KEY_ID=rzp_test_sharpshadow_key
RAZORPAY_KEY_SECRET=rzp_test_sharpshadow_secret
RAZORPAY_WEBHOOK_SECRET=whsec_sharpshadow_secret

# Storage Configuration (local, r2, or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_PRIVATE_DIR=./storage/private

# Cloudflare R2 Storage (Set STORAGE_TYPE=r2 to activate)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=sharpshadow-assets
# Public CDN / Custom Domain for thumbnails & previews (e.g. https://pub-xxxxxx.r2.dev or https://cdn.sharpshadow.com)
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Generic S3 Storage (Set STORAGE_TYPE=s3 to activate)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_BUCKET=sharpshadow-psds
STORAGE_REGION=ap-south-1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
